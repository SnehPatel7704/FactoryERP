generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Master Data
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("operator") // admin, operator, manager
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  basePrice   Float    @default(120.0) // Per-Kg or unit price
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Many-to-Many relations
  colors    Color[]
  sizes     Size[]
  qualities Quality[]

  lineItems         LineItem[]
  productionEntries ProductionEntry[]
}

model Color {
  id                String            @id @default(uuid())
  name              String            @unique
  hexCode           String?
  items             Item[]
  lineItems         LineItem[]
  productionEntries ProductionEntry[]
  secondaryEntries  ProductionEntry[] @relation("secondary")
  accentEntries     ProductionEntry[] @relation("accent")
}

model Size {
  id                String            @id @default(uuid())
  value             String            @unique // e.g., "200mm"
  items             Item[]
  lineItems         LineItem[]
  productionEntries ProductionEntry[]
}

model Quality {
  id                String            @id @default(uuid())
  grade             String            @unique // e.g., "Grade A+"
  items             Item[]
  lineItems         LineItem[]
  productionEntries ProductionEntry[]
}

model WeightConfig {
  id         String   @id @default(uuid())
  value      Float    // e.g., 10.5
  type       String   @default("Standard")
  isStandard Boolean  @default(true)

  @@unique([value, type]) // Composite unique constraint
}

model MeterConfig {
  id    String  @id @default(uuid())
  value Float   // e.g., 100.0
  type  String  @default("Industrial")

  @@unique([value, type]) // Composite unique constraint
}

// Sales Orders
model SalesOrder {
  id            String    @id @default(uuid())
  orderNumber   String    @unique
  customerName  String
  status        String    @default("draft") // draft, pending, confirmed
  expectedDate  DateTime?
  internalNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lineItems         LineItem[]
  productionEntries ProductionEntry[]
}

model LineItem {
  id           String     @id @default(uuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  itemId           String
  item             Item    @relation(fields: [itemId], references: [id])
  sizeId           String
  size             Size    @relation(fields: [sizeId], references: [id])
  qualityId        String
  quality          Quality @relation(fields: [qualityId], references: [id])
  colorId          String
  color            Color   @relation(fields: [colorId], references: [id])
  secondaryColorId String?

  weightId    Float
  lengthMeter Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Production Entries tracking daily output linked to orders
model ProductionEntry {
  id            String  @id @default(uuid())
  type          String  @default("entry") // "entry" or "return"
  status        String  @default("created") // created, staged, dispatched, returned
  shiftCode     String?
  machineCenter String?
  operatorId    String?

  sku         String    @unique // QR/SKU code for scanning: PREFIX-TIMESTAMP-RANDOM (e.g., SKU-1234567890-ABC123)
  bagsCount   Int       @default(0)
  batchNumber String? // Batch or Slot identifier
  entryDate   DateTime?
  weightId    Float?
  lengthMeter Float?

  // Specific Entity Master Links
  itemId           String?
  item             Item?         @relation(fields: [itemId], references: [id])
  sizeId           String?
  size             Size?         @relation(fields: [sizeId], references: [id])
  qualityId        String?
  quality          Quality?      @relation(fields: [qualityId], references: [id])
  colorId          String?
  color            Color?        @relation(fields: [colorId], references: [id])
  secondaryColorId String?
  secondaryColor   Color?        @relation("secondary", fields: [secondaryColorId], references: [id])
  accentColorId    String?
  accentColor      Color?        @relation("accent", fields: [accentColorId], references: [id])

  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Logistics Core
model DispatchChallan {
  id            String   @id @default(uuid())
  challanNumber String   @unique
  vehicleNo     String?
  transporter   String?
  driverContact String?
  destination   String?
  status        String   @default("staged") // staged, dispatched, delivered, returned
  dispatchDate  DateTime @default(now())

  lines DispatchLine[]
}

model DispatchLine {
  id            String          @id @default(uuid())
  challanId     String
  challan       DispatchChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productionId  String?
  batchweightId Float           @default(0)
  description   String?
}
